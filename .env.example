# ---- 大模型 ----
# 所有调用都走 app/llm/provider.py 的 call_llm(prompt, model)，
# 换模型不需要改业务代码，只要在 provider.MODELS 里把 status 改成 ready。

# DeepSeek（已接通，界面显示名 DeepSeek V4.1）
# ⚠️ 不要在这里填真实 Key —— 本文件已被 Git 跟踪，会进公开仓库。
#    真实 Key 请填到同目录的 .env（已被 .gitignore 排除）。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 通义千问（预留：填入 Key 并把 provider.MODELS["qwen"].status 改为 ready 即生效）
# 三家都兼容 OpenAI 协议，所以不需要额外 SDK
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
DASHSCOPE_API_KEY=

# Kimi / Moonshot（预留，同上）
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k
MOONSHOT_API_KEY=

# ---- OCR 服务 ----
# 候选: rapidocr(本地,无需 key,默认) / baidu / tencent
OCR_PROVIDER=rapidocr

# 百度 OCR：在 ai.baidu.com 创建应用后获取这三个值
# ⚠️ 字段名必须与 bench.py 读取的一致（BAIDU_OCR_ 前缀），否则不会生效
BAIDU_OCR_APP_ID=
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=

# 腾讯 OCR（备选，待接入）
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# ---- 数据库 ----
# SQLite 单文件,默认落在 data/ 下
DB_PATH=data/tijian.db

# ---- 调试 ----
LOG_LEVEL=info
