# ---- 大模型 ----
# 所有调用都走 app/llm/provider.py 的 call_llm(prompt, model)，
# 换模型不需要改业务代码，只要在 provider.MODELS 里把 status 改成 ready。

# DeepSeek（已接通，界面显示名 DeepSeek V4.1）
# ⚠️ 不要在这里填真实 Key —— 本文件已被 Git 跟踪，会进公开仓库。
#    真实 Key 请填到同目录的 .env（已被 .gitignore 排除）。
# ⚠️ DEEPSEEK_MODEL 必须是当前在售的模型名。旧名 deepseek-chat 已退役，
#    调它不报错但会被服务端静默改写到别的模型上，配置和实际就对不上了。
#    当前在售：deepseek-flash（V4.1 Flash）/ deepseek-v4-pro。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash

# ============================================================================
# 预留多模型扩展示例：取消注释并填入 Key 即可启用
# ----------------------------------------------------------------------------
# 用法：把下面几行的 "# " 去掉 → 填入 Key → 把 provider.MODELS 里对应条目的
#       status 从 "wiring" 改成 "ready"。业务代码一行都不用动。
# 现在整段注释着，是因为配置里躺着一堆「填了也不生效」的变量最容易骗人。
# 模型名已核对到 2026-10-19，启用前请再对一次官网清单。
#
# # 通义千问（阿里云百炼，兼容 OpenAI 协议）
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen3.7-plus
# DASHSCOPE_API_KEY=
#
# # Kimi / Moonshot（moonshot-v1 全系已于 2026-08-31 下线，现役为 kimi-k3）
# KIMI_BASE_URL=https://api.moonshot.cn/v1
# KIMI_MODEL=kimi-k3
# MOONSHOT_API_KEY=
# ============================================================================

# ---- OCR 服务 ----
# 候选: rapidocr(本地,无需 key,默认) / baidu / tencent
OCR_PROVIDER=rapidocr

# 百度 OCR：在 ai.baidu.com 创建应用后获取这三个值
# ⚠️ 字段名必须与 bench.py 读取的一致（BAIDU_OCR_ 前缀），否则不会生效
BAIDU_OCR_APP_ID=
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=

# 腾讯 OCR（备选，待接入）
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# ---- 数据库 ----
# SQLite 单文件,默认落在 data/ 下
DB_PATH=data/tijian.db

# ---- 调试 ----
LOG_LEVEL=info
