# ---- DeepSeek API ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- OCR 服务 ----
# 候选: rapidocr(本地,无需 key,默认) / baidu / tencent
OCR_PROVIDER=rapidocr

# 百度 OCR：在 ai.baidu.com 创建应用后获取这三个值
# ⚠️ 字段名必须与 bench.py 读取的一致（BAIDU_OCR_ 前缀），否则不会生效
BAIDU_OCR_APP_ID=
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=

# 腾讯 OCR（备选，待接入）
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# ---- 数据库 ----
# SQLite 单文件,默认落在 data/ 下
DB_PATH=data/tijian.db

# ---- 调试 ----
LOG_LEVEL=info
